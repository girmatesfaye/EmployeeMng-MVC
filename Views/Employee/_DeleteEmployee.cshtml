@page
@model EmployeeManagementSystem.Pages.Employees.DeleteModel
@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-danger">
                <!-- Card Header -->
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-trash-alt"></i> Delete Employee
                    </h4>
                </div>

                <!-- Card Body -->
                <div class="card-body">
                    <!-- Warning Alert -->
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Warning!</strong> This action cannot be undone.
                    </div>

                    <h5 class="text-center mb-3">Are you sure you want to delete this employee?</h5>

                    <!-- Employee Information Card -->
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Employee Information</h6>
                        </div>
                        <div class="card-body">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Employee ID</dt>
                                <dd class="col-sm-8">@Model.Employee.Id</dd>

                                <dt class="col-sm-4">Full Name</dt>
                                <dd class="col-sm-8 fw-bold text-primary">@Model.Employee.Name</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Model.Employee.Email</dd>

                                <dt class="col-sm-4">Department</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-primary">@Model.Employee.Department</span>
                                </dd>

                                <dt class="col-sm-4">Hire Date</dt>
                                <dd class="col-sm-8">@Model.Employee.HireDate.ToString("MMMM dd, yyyy")</dd>

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Employee.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Delete Form -->
                    <form method="post" onsubmit="return confirmDelete()">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Employee.Id" />
                        <input type="hidden" asp-for="Employee.Name" />
                        <input type="hidden" asp-for="Employee.Email" />
                        <input type="hidden" asp-for="Employee.Department" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Delete Employee
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript for confirmation -->
<script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this employee? This action cannot be undone!');
    }
</script>