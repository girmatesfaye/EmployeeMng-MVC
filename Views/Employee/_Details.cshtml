@model Employee_Management_System.Models.Employee

<div class="modal fade"
     id="detailsModal">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5>Employee Details</h5>

            </div>

            <div class="modal-body">

                <dl class="row">

                    <dt class="col-4">
                        Name
                    </dt>

                    <dd class="col-8">
                        @Model.Name
                    </dd>

                    <dt class="col-4">
                        Department
                    </dt>

                    <dd class="col-8">
                        @Model.Department
                    </dd>

                    <dt class="col-4">
                        Salary
                    </dt>

                    <dd class="col-8">
                        @Model.Salary
                    </dd>

                    <dt class="col-4">
                        Status
                    </dt>

                    <dd class="col-8">
                        @if (Model.Status == "Active")
                              {
                                  <span class="badge bg-success">Active</span>
                              }
                              else if (Model.Status == "Inactive")
                              {
                                  <span class="badge bg-secondary">Inactive</span>
                              }
                              else if (Model.Status == "On Leave")
                              {
                                  <span class="badge bg-warning text-dark">On Leave</span>
                              }
                              else if (Model.Status == "Suspended")
                              {
                                  <span class="badge bg-danger">Suspended</span>
                              }
                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>