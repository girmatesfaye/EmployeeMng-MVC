@model List<Employee_Management_System.Models.Employee>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Status</th>
            <th>Hire Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.Name</td>
                    <td>@employee.Email</td>
                    <td>
                        <span class="badge bg-primary">@employee.Department</span>
                    </td>
                    <td>
                        <!-- ✅ FIXED: Use employee.Status, not Model.Status -->
                        @if (employee.Status == EmployeeStatus.Active)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else if (employee.Status == EmployeeStatus.Inactive)
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                        else if (employee.Status == EmployeeStatus.OnLeave)
                        {
                            <span class="badge bg-warning text-dark">On Leave</span>
                        }
                        else if (employee.Status == EmployeeStatus.Terminated)
                        {
                            <span class="badge bg-dark">Terminated</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Unknown</span>
                        }
                    </td>
                    <td>@employee.CreatedAt.ToShortDateString()</td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-page="./Details" asp-route-id="@employee.Id" class="btn btn-info">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@employee.Id" class="btn btn-primary">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-page="./Delete" asp-route-id="@employee.Id" class="btn btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">
                    <i class="fas fa-info-circle"></i> No employees found.
                    <a asp-page="./Create">Create one</a>
                </td>
            </tr>
        }
    </tbody>
</table>