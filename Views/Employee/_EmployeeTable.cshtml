<table class="table table-bordered table-hover">

    <thead class="table-dark">

        <tr>

            <th>ID</th>

            <th>Name</th>

            <th>Department</th>

            <th>Salary</th>

            <th>Status</th>

            <th>Action</th>

        </tr>

    </thead>

    <tbody>

    @foreach(var item in Model)
    {
        <tr>

            <td>@item.Id</td>

            <td>@item.Name</td>

            <td>@item.Department</td>

            <td>@item.Salary</td>

            <td>

                @if(item.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }

            </td>

            <td>

                <button class="btn btn-info btn-sm details"
                        data-id="@item.Id">

                    Details

                </button>

                <button class="btn btn-warning btn-sm edit"
                        data-id="@item.Id">

                    Edit

                </button>

                <button class="btn btn-danger btn-sm delete"
                        data-id="@item.Id">

                    Delete

                </button>

            </td>

        </tr>
    }

    </tbody>

</table>